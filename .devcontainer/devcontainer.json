{
  "name": "mb-relay",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "MovieBox Relay",
      "protocol": "https"
    }
  },
  "postStartCommand": "nohup python3 relay.py > /tmp/relay.log 2>&1 & sh public_port.sh"
}
